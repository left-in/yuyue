{
  "$comment": [
    "Single source of the 语阅 design tokens. Run `node design/generate.mjs` after editing; it writes",
    "reader/src/generated/tokens.css, apple/Yuyue/Design/Tokens.swift and",
    "android/app/src/main/java/app/yuyue/design/Tokens.kt.",
    "(v0.22 status colours, v0.28 theme tints, paper rules, reading-view typography).",
    "Colours are #RRGGBB or rgba(r,g,b,a). Typography sizes marked 'px' are design pixels at a",
    "14px text size; the reader scales them with the user's font size (value / 14 em)."
  ],
  "prototypeTextPx": 14,

  "color": {
    "$comment": "UI colours (界面). black / onBlack / accent / accentSoft depend on the theme tint, see `tint`.",
    "light": {
      "bg": "#F6F5F3",
      "card": "#FFFFFF",
      "inset": "#EFEEEB",
      "line": "#E7E5E1",
      "t1": "#2A2B2E",
      "t2": "#6E6B68",
      "t3": "#8A8682",
      "tint": "#C9C4BD",
      "player": "#ECEBE8",
      "hlY": "#FBE7A0",
      "hlR": "#EF7F71",
      "hlB": "#C4E3F4",
      "mkY": "#FBE7A0",
      "mkB": "#CFE6F4",
      "mkP": "#F6C7C0",
      "ok": "#3E9B6A",
      "danger": "#C2473A",
      "warn": "#B7791F",
      "glass": "rgba(255,255,255,.86)",
      "fade0": "rgba(246,245,243,0)",
      "pill": "#FBFAF7",
      "pillLine": "rgba(80,65,45,.16)"
    },
    "dark": {
      "bg": "#101112",
      "card": "#1B1C1E",
      "inset": "#26272A",
      "line": "#2C2D30",
      "t1": "#EDEDEE",
      "t2": "#9A9895",
      "t3": "#8E8C89",
      "tint": "#4E4C49",
      "player": "#18191B",
      "hlY": "#FBE7A0",
      "hlR": "#EF7F71",
      "hlB": "#C4E3F4",
      "mkY": "rgba(251,231,160,.26)",
      "mkB": "rgba(196,227,244,.22)",
      "mkP": "rgba(246,199,192,.24)",
      "ok": "#5DBB88",
      "danger": "#E5806F",
      "warn": "#D9A54A",
      "glass": "rgba(30,31,34,.86)",
      "fade0": "rgba(16,17,18,0)",
      "pill": "#2C2D30",
      "pillLine": "rgba(255,255,255,.1)"
    }
  },

  "tint": {
    "$comment": [
      "主题色: 松绿 (default), 茶色, 苔绿, 黛紫. 墨蓝 and 墨黑 are no longer theme colours.",
      "black/onBlack: the main button, a faint wash of the colour with the colour as its words. edge: its hairline.",
      "fill: switches, progress bars (a lighter tone so they do not weigh on the page). soft/onSoft: soft chips.",
      "paperAccent: accent drawn on paper (search hits, footnote refs, bookmarks), follows the paper, not the UI appearance.",
      "play: the play button on each paper (--v-pm / --v-pmk / --v-pmd / --v-pmn, sage like plain); the e-ink paper never follows the tint."
    ],
    "default": "pine",
    "pine": {
      "name": "松绿",
      "light": { "black": "#EAF4F0", "onBlack": "#246858", "accent": "#246858", "accentSoft": "rgba(36,104,88,.1)", "edge": "rgba(36,104,88,.32)", "fill": "#40927A", "soft": "rgba(36,104,88,.1)", "onSoft": "#246858" },
      "dark": { "black": "rgba(120,190,170,.16)", "onBlack": "#78BEAA", "accent": "#78BEAA", "accentSoft": "rgba(120,190,170,.16)", "edge": "rgba(120,190,170,.35)", "fill": "#4A9680", "soft": "rgba(120,190,170,.16)", "onSoft": "#78BEAA" },
      "paperAccent": { "lightPaper": "#246858", "darkPaper": "#78BEAA" },
      "play": { "plain": "#246858", "kami": "#246858", "dark": "#78BEAA", "kaminight": "#78BEAA", "sage": "#246858" }
    },
    "tea": {
      "name": "茶色",
      "light": { "black": "#F8EFE6", "onBlack": "#8C5832", "accent": "#8C5832", "accentSoft": "rgba(140,88,50,.1)", "edge": "rgba(140,88,50,.32)", "fill": "#AA744C", "soft": "rgba(140,88,50,.1)", "onSoft": "#8C5832" },
      "dark": { "black": "rgba(214,164,124,.16)", "onBlack": "#D6A47C", "accent": "#D6A47C", "accentSoft": "rgba(214,164,124,.16)", "edge": "rgba(214,164,124,.35)", "fill": "#B07850", "soft": "rgba(214,164,124,.16)", "onSoft": "#D6A47C" },
      "paperAccent": { "lightPaper": "#8C5832", "darkPaper": "#D6A47C" },
      "play": { "plain": "#8C5832", "kami": "#8C5832", "dark": "#D6A47C", "kaminight": "#D6A47C", "sage": "#8C5832" }
    },
    "moss": {
      "name": "苔绿",
      "light": { "black": "#F0F3E5", "onBlack": "#58682C", "accent": "#58682C", "accentSoft": "rgba(88,104,44,.1)", "edge": "rgba(88,104,44,.32)", "fill": "#748840", "soft": "rgba(88,104,44,.1)", "onSoft": "#58682C" },
      "dark": { "black": "rgba(178,194,120,.16)", "onBlack": "#B2C278", "accent": "#B2C278", "accentSoft": "rgba(178,194,120,.16)", "edge": "rgba(178,194,120,.35)", "fill": "#809246", "soft": "rgba(178,194,120,.16)", "onSoft": "#B2C278" },
      "paperAccent": { "lightPaper": "#58682C", "darkPaper": "#B2C278" },
      "play": { "plain": "#58682C", "kami": "#58682C", "dark": "#B2C278", "kaminight": "#B2C278", "sage": "#58682C" }
    },
    "dai": {
      "name": "黛紫",
      "light": { "black": "#F0EDF8", "onBlack": "#5E4E92", "accent": "#5E4E92", "accentSoft": "rgba(94,78,146,.1)", "edge": "rgba(94,78,146,.32)", "fill": "#7C6CB4", "soft": "rgba(94,78,146,.1)", "onSoft": "#5E4E92" },
      "dark": { "black": "rgba(176,164,226,.16)", "onBlack": "#B0A4E2", "accent": "#B0A4E2", "accentSoft": "rgba(176,164,226,.16)", "edge": "rgba(176,164,226,.35)", "fill": "#7C6CBE", "soft": "rgba(176,164,226,.16)", "onSoft": "#B0A4E2" },
      "paperAccent": { "lightPaper": "#5E4E92", "darkPaper": "#B0A4E2" },
      "play": { "plain": "#5E4E92", "kami": "#5E4E92", "dark": "#B0A4E2", "kaminight": "#B0A4E2", "sage": "#5E4E92" }
    }
  },

  "font": {
    "$comment": "css: the stack the reader uses. apple/android: font family names to try natively, in order, before the system fallback (`system`).",
    "sans": {
      "css": "-apple-system,BlinkMacSystemFont,\"PingFang SC\",\"Hiragino Sans GB\",\"Microsoft YaHei\",sans-serif",
      "apple": [],
      "android": [],
      "system": "sans"
    },
    "serif": {
      "css": "\"Noto Serif SC\",\"Source Han Serif SC\",\"Songti SC\",\"STSong\",serif",
      "apple": ["Noto Serif SC", "Source Han Serif SC", "Songti SC"],
      "android": ["Noto Serif CJK SC", "Source Han Serif SC"],
      "system": "serif"
    },
    "kai": {
      "css": "\"LXGW WenKai\",\"Kaiti SC\",\"STKaiti\",\"KaiTi\",serif",
      "apple": ["LXGW WenKai", "Kaiti SC", "STKaiti"],
      "android": ["LXGW WenKai"],
      "system": "serif"
    },
    "kaiti": {
      "$comment": "排版里的“楷体”：只用系统的楷体，不借霞鹜文楷。",
      "css": "\"Kaiti SC\",\"STKaiti\",\"KaiTi\",serif",
      "apple": ["Kaiti SC", "STKaiti"],
      "android": [],
      "system": "serif"
    },
    "wenkai": {
      "$comment": "排版里的“霞鹜文楷”：第一次选时下载；没下载完先用楷体。",
      "css": "\"LXGW WenKai\",\"Kaiti SC\",\"STKaiti\",serif",
      "apple": ["LXGW WenKai Lite", "LXGW WenKai", "Kaiti SC"],
      "android": [],
      "system": "serif"
    },
    "mono": {
      "css": "ui-monospace,\"SF Mono\",Menlo,Consolas,monospace",
      "apple": [],
      "android": [],
      "system": "mono"
    },
    "latinSerif": {
      "$comment": "English body text in the reader (.r-text.en).",
      "css": "Georgia,\"Times New Roman\",serif",
      "apple": ["Georgia"],
      "android": [],
      "system": "serif"
    }
  },

  "shadow": {
    "$comment": "Layers in CSS order: x, y, blur, spread (px), colour. spread>0 with blur 0 is a hairline ring.",
    "light": {
      "card":  [[0, 1, 2, 0, "rgba(51,46,41,.04)"], [0, 8, 24, 0, "rgba(51,46,41,.05)"]],
      "float": [[0, 10, 30, 0, "rgba(51,46,41,.14)"], [0, 1, 3, 0, "rgba(51,46,41,.08)"]],
      "ring":  [[0, 0, 0, 0.5, "#E7E5E1"], [0, 1, 2, 0, "rgba(51,46,41,.04)"]],
      "ringFloat": [[0, 0, 0, 0.5, "#E7E5E1"], [0, 8, 24, 0, "rgba(51,46,41,.1)"]]
    },
    "dark": {
      "card":  [[0, 0, 0, 0.5, "rgba(255,255,255,.05)"]],
      "float": [[0, 10, 30, 0, "rgba(0,0,0,.5)"], [0, 0, 0, 0.5, "rgba(255,255,255,.07)"]],
      "ring":  [[0, 0, 0, 0.5, "rgba(255,255,255,.06)"]],
      "ringFloat": [[0, 0, 0, 0.5, "rgba(255,255,255,.08)"], [0, 16, 40, 0, "rgba(0,0,0,.5)"]]
    }
  },

  "radius": {
    "$comment": "Corner radii (pt/dp/px) used by the confirmed components; the design language has no radius tokens of its own.",
    "card": 16,
    "block": 14,
    "sheet": 22,
    "capsule": 24,
    "control": 10,
    "chip": 999
  },

  "motion": {
    "$comment": "动效: milliseconds. quick: hover, press, an icon changing. standard: a card or panel coming and going, colours, progress. layout: things moving to a new place (re-sorting, the sidebar's selection, opening and closing). exit: going away, a little quicker than coming. No bounce anywhere; with 减弱动态效果 on, moves are instant and the rest only fades.",
    "quick": 140,
    "standard": 240,
    "layout": 350,
    "exit": 120
  },

  "paper": {
    "$comment": [
      "纸页. Colours from .paper-* (--p-*). main/onMain: play button on that paper with the default tint",
      "(per-tint values in tint.*.play). paperAccent is tint.*.paperAccent (identical for both tints).",
      "text: body typography defaults (the user's settings override them). title/meta: section title and the",
      "'读 X 分钟 · 听 X 分钟' line (.r-title / .r-meta). Sizes in design px at 14px text."
    ],
    "plain": {
      "name": "素白", "dark": false,
      "bg": "#FFFFFF", "ink": "#2A2B2E", "ink2": "#777571", "line": "#EFEEEB", "accent": "#2A2B2E",
      "hl": "#FBE7A0", "wave": "#EF7F71", "glass": "rgba(255,255,255,.82)", "main": "#2B4C7E", "onMain": "#FFFFFF",
      "paperAccent": "#2B4C7E",
      "text": { "font": "sans", "lineHeight": 2.15, "paragraphSpacingEm": 1.1, "indentEm": 0, "justify": true, "letterSpacingEm": 0.02, "sizePx": 14 },
      "title": { "font": "sans", "sizePx": 22, "weight": 700, "lineHeight": 1.4, "letterSpacingEm": 0, "rule": false },
      "meta": { "font": "sans", "sizePx": 10.5, "border": true, "letterSpacingEm": 0, "marginTopPx": 10, "paddingBottomPx": 14 }
    },
    "dark": {
      "name": "暗黑", "dark": true,
