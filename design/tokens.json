{
  "$comment": [
    "Single source of the 语阅 design tokens. Run `node design/generate.mjs` after editing; it writes",
    "reader/src/generated/tokens.css, apple/Yuyue/Design/Tokens.swift and",
    "android/app/src/main/java/app/yuyue/design/Tokens.kt.",
    "Sources: design-language-v0.21-confirmed.html (:root and the dark variant) and prototype-v0.28.html",
    "(v0.22 status colours, v0.28 theme tints, paper rules, reading-view typography).",
    "Colours are #RRGGBB or rgba(r,g,b,a). Typography sizes marked 'px' are prototype pixels at the",
    "prototype's 14px text size; the reader scales them with the user's font size (value / 14 em)."
  ],
  "prototypeTextPx": 14,

  "color": {
    "$comment": "UI colours (界面). black / onBlack / accent / accentSoft depend on the theme tint, see `tint`.",
    "light": {
      "bg": "#F6F5F3",
      "card": "#FFFFFF",
      "inset": "#EFEEEB",
      "line": "#E7E5E1",
      "t1": "#2A2B2E",
      "t2": "#85827F",
      "t3": "#A8A49F",
      "tint": "#C9C4BD",
      "player": "#ECEBE8",
      "hlY": "#FBE7A0",
      "hlR": "#EF7F71",
      "hlB": "#C4E3F4",
      "mkY": "#FBE7A0",
      "mkB": "#CFE6F4",
      "mkP": "#F6C7C0",
      "ok": "#3E9B6A",
      "danger": "#C2473A",
      "warn": "#B7791F",
      "glass": "rgba(255,255,255,.86)",
      "fade0": "rgba(246,245,243,0)"
    },
    "dark": {
      "bg": "#101112",
      "card": "#1B1C1E",
      "inset": "#26272A",
      "line": "#2C2D30",
      "t1": "#EDEDEE",
      "t2": "#9A9895",
      "t3": "#75726E",
      "tint": "#4E4C49",
      "player": "#18191B",
      "hlY": "#FBE7A0",
      "hlR": "#EF7F71",
      "hlB": "#C4E3F4",
      "mkY": "rgba(251,231,160,.26)",
      "mkB": "rgba(196,227,244,.22)",
      "mkP": "rgba(246,199,192,.24)",
      "ok": "#5DBB88",
      "danger": "#E5806F",
      "warn": "#D9A54A",
      "glass": "rgba(30,31,34,.86)",
      "fade0": "rgba(16,17,18,0)"
    }
  },

  "tint": {
    "$comment": [
      "主题色 (prototype v0.28). `blue` 墨蓝 is the default; `ink` 墨黑 is the originally confirmed look.",
      "black/onBlack: main buttons. fill: switches, progress bars. soft/onSoft: soft chips.",
      "paperAccent: accent drawn on paper (search hits, footnote refs, bookmarks), follows the paper, not the UI appearance.",
      "play: the play button on each paper (--v-pm / --v-pmk / --v-pmd / --v-pmn); the e-ink paper never follows the tint."
    ],
    "default": "blue",
    "blue": {
      "name": "墨蓝",
      "light": { "black": "#2B4C7E", "onBlack": "#FFFFFF", "accent": "#2B4C7E", "accentSoft": "rgba(43,76,126,.12)", "fill": "#2B4C7E", "soft": "rgba(43,76,126,.12)", "onSoft": "#2B4C7E" },
      "dark": { "black": "#8FA8C8", "onBlack": "#101214", "accent": "#8FA8C8", "accentSoft": "rgba(143,168,200,.16)", "fill": "#8FA8C8", "soft": "rgba(143,168,200,.16)", "onSoft": "#8FA8C8" },
      "paperAccent": { "lightPaper": "#2B4C7E", "darkPaper": "#8FA8C8" },
      "play": { "plain": "#2B4C7E", "kami": "#1B365D", "dark": "#8FA8C8", "kaminight": "#8FA8C8" }
    },
    "ink": {
      "name": "墨黑",
      "light": { "black": "#101214", "onBlack": "#FFFFFF", "accent": "#2B4C7E", "accentSoft": "rgba(43,76,126,.12)", "fill": "#2A2B2E", "soft": "rgba(42,43,46,.08)", "onSoft": "#2A2B2E" },
      "dark": { "black": "#EDEDEE", "onBlack": "#101214", "accent": "#8FA8C8", "accentSoft": "rgba(143,168,200,.16)", "fill": "#EDEDEE", "soft": "rgba(237,237,238,.08)", "onSoft": "#EDEDEE" },
      "paperAccent": { "lightPaper": "#2B4C7E", "darkPaper": "#8FA8C8" },
      "play": { "plain": "#101214", "kami": "#1B365D", "dark": "#D6D6D8", "kaminight": "#8FA8C8" }
    }
  },

  "font": {
    "$comment": "css: the stack the reader and prototype use. apple/android: font family names to try natively, in order, before the system fallback (`system`).",
    "sans": {
      "css": "-apple-system,BlinkMacSystemFont,\"PingFang SC\",\"Hiragino Sans GB\",\"Microsoft YaHei\",sans-serif",
      "apple": [],
      "android": [],
      "system": "sans"
    },
    "serif": {
      "css": "\"Noto Serif SC\",\"Source Han Serif SC\",\"Songti SC\",\"STSong\",serif",
      "apple": ["Noto Serif SC", "Source Han Serif SC", "Songti SC"],
      "android": ["Noto Serif CJK SC", "Source Han Serif SC"],
      "system": "serif"
    },
    "kai": {
      "css": "\"LXGW WenKai\",\"Kaiti SC\",\"STKaiti\",\"KaiTi\",serif",
      "apple": ["LXGW WenKai", "Kaiti SC", "STKaiti"],
      "android": ["LXGW WenKai"],
      "system": "serif"
    },
    "kaiti": {
      "$comment": "排版里的“楷体”：只用系统的楷体，不借霞鹜文楷。",
      "css": "\"Kaiti SC\",\"STKaiti\",\"KaiTi\",serif",
      "apple": ["Kaiti SC", "STKaiti"],
      "android": [],
      "system": "serif"
    },
    "wenkai": {
      "$comment": "排版里的“霞鹜文楷”：第一次选时下载；没下载完先用楷体。",
      "css": "\"LXGW WenKai\",\"Kaiti SC\",\"STKaiti\",serif",
      "apple": ["LXGW WenKai Lite", "LXGW WenKai", "Kaiti SC"],
      "android": [],
      "system": "serif"
    },
    "mono": {
      "css": "ui-monospace,\"SF Mono\",Menlo,Consolas,monospace",
      "apple": [],
      "android": [],
      "system": "mono"
    },
    "latinSerif": {
      "$comment": "English body text in the reader (.r-text.en).",
      "css": "Georgia,\"Times New Roman\",serif",
      "apple": ["Georgia"],
      "android": [],
      "system": "serif"
    }
  },

  "shadow": {
    "$comment": "Layers in CSS order: x, y, blur, spread (px), colour. spread>0 with blur 0 is a hairline ring.",
    "light": {
      "card":  [[0, 1, 2, 0, "rgba(51,46,41,.04)"], [0, 8, 24, 0, "rgba(51,46,41,.05)"]],
      "float": [[0, 10, 30, 0, "rgba(51,46,41,.14)"], [0, 1, 3, 0, "rgba(51,46,41,.08)"]],
      "ring":  [[0, 0, 0, 0.5, "#E7E5E1"], [0, 1, 2, 0, "rgba(51,46,41,.04)"]],
      "ringFloat": [[0, 0, 0, 0.5, "#E7E5E1"], [0, 8, 24, 0, "rgba(51,46,41,.1)"]]
    },
    "dark": {
      "card":  [[0, 0, 0, 0.5, "rgba(255,255,255,.05)"]],
      "float": [[0, 10, 30, 0, "rgba(0,0,0,.5)"], [0, 0, 0, 0.5, "rgba(255,255,255,.07)"]],
      "ring":  [[0, 0, 0, 0.5, "rgba(255,255,255,.06)"]],
      "ringFloat": [[0, 0, 0, 0.5, "rgba(255,255,255,.08)"], [0, 16, 40, 0, "rgba(0,0,0,.5)"]]
    }
  },

  "radius": {
    "$comment": "Corner radii (pt/dp/px) used by the confirmed components; the design language has no radius tokens of its own.",
    "card": 16,
    "block": 14,
    "sheet": 22,
    "capsule": 24,
    "control": 10,
    "chip": 999
  },

  "paper": {
    "$comment": [
      "纸页. Colours from .paper-* (--p-*). main/onMain: play button on that paper with the default tint",
      "(per-tint values in tint.*.play). paperAccent is tint.*.paperAccent (identical for both tints).",
      "text: body typography defaults (the user's settings override them). title/meta: section title and the",
      "'读 X 分钟 · 听 X 分钟' line (.r-title / .r-meta). Sizes in prototype px at 14px text."
    ],
    "plain": {
      "name": "素白", "dark": false,
      "bg": "#FFFFFF", "ink": "#2A2B2E", "ink2": "#9A9894", "line": "#EFEEEB", "accent": "#2A2B2E",
      "hl": "#FBE7A0", "wave": "#EF7F71", "glass": "rgba(255,255,255,.82)", "main": "#2B4C7E", "onMain": "#FFFFFF",
      "paperAccent": "#2B4C7E",
      "text": { "font": "sans", "lineHeight": 2.15, "paragraphSpacingEm": 1.1, "indentEm": 0, "justify": true, "letterSpacingEm": 0.02, "sizePx": 14 },
      "title": { "font": "sans", "sizePx": 22, "weight": 700, "lineHeight": 1.4, "letterSpacingEm": 0, "rule": false },
      "meta": { "font": "sans", "sizePx": 10.5, "border": true, "letterSpacingEm": 0, "marginTopPx": 10, "paddingBottomPx": 14 }
    },
    "dark": {
      "name": "暗黑", "dark": true,
      "bg": "#121314", "ink": "#D6D6D8", "ink2": "#77777C", "line": "#26272A", "accent": "#D6D6D8",
      "hl": "#51461F", "wave": "#E57A6E", "glass": "rgba(34,35,38,.82)", "main": "#8FA8C8", "onMain": "#121314",
      "paperAccent": "#8FA8C8",
      "text": { "font": "sans", "lineHeight": 2.15, "paragraphSpacingEm": 1.1, "indentEm": 0, "justify": true, "letterSpacingEm": 0.02, "sizePx": 14 },
      "title": { "font": "sans", "sizePx": 22, "weight": 700, "lineHeight": 1.4, "letterSpacingEm": 0, "rule": false },
      "meta": { "font": "sans", "sizePx": 10.5, "border": true, "letterSpacingEm": 0, "marginTopPx": 10, "paddingBottomPx": 14 }
    },
    "kami": {
      "name": "纸本", "dark": false,
      "bg": "#F5F4ED", "ink": "#26251F", "ink2": "#7A776B", "line": "#E2DFD3", "accent": "#1B365D",
      "hl": "#E9E0C2", "wave": "#1B365D", "glass": "rgba(250,249,244,.84)", "main": "#1B365D", "onMain": "#F5F4ED",
      "paperAccent": "#2B4C7E",
      "text": { "font": "serif", "lineHeight": 2.05, "paragraphSpacingEm": 0.3, "indentEm": 2, "justify": true, "letterSpacingEm": 0.01, "sizePx": 14.5 },
      "title": { "font": "serif", "sizePx": 25, "weight": 700, "lineHeight": 1.4, "letterSpacingEm": 0.05, "rule": true },
      "meta": { "font": "serif", "sizePx": 10.5, "border": false, "letterSpacingEm": 0.06, "marginTopPx": 0, "paddingBottomPx": 4 }
    },
    "kaminight": {
      "name": "纸本 · 夜", "dark": true,
      "bg": "#1B1A17", "ink": "#E3DED0", "ink2": "#8C8779", "line": "#2E2C27", "accent": "#8FA8C8",
      "hl": "#463F2C", "wave": "#8FA8C8", "glass": "rgba(40,38,34,.84)", "main": "#8FA8C8", "onMain": "#1B1A17",
      "paperAccent": "#8FA8C8",
      "text": { "font": "serif", "lineHeight": 2.05, "paragraphSpacingEm": 0.3, "indentEm": 2, "justify": true, "letterSpacingEm": 0.01, "sizePx": 14.5 },
      "title": { "font": "serif", "sizePx": 25, "weight": 700, "lineHeight": 1.4, "letterSpacingEm": 0.05, "rule": true },
      "meta": { "font": "serif", "sizePx": 10.5, "border": false, "letterSpacingEm": 0.06, "marginTopPx": 0, "paddingBottomPx": 4 }
    },
    "eink": {
      "name": "墨水屏", "dark": false, "texture": "noise",
      "bg": "#E9E8E3", "ink": "#141414", "ink2": "#555555", "line": "#C9C8C2", "accent": "#141414",
      "hl": "rgba(0,0,0,0)", "wave": "#141414", "glass": "#E9E8E3", "main": "#141414", "onMain": "#E9E8E3",
      "paperAccent": "#141414",
      "text": { "font": "serif", "lineHeight": 2.05, "paragraphSpacingEm": 0.3, "indentEm": 2, "justify": true, "letterSpacingEm": 0.02, "sizePx": 14 },
      "title": { "font": "serif", "sizePx": 24, "weight": 700, "lineHeight": 1.4, "letterSpacingEm": 0.05, "rule": false },
      "meta": { "font": "sans", "sizePx": 10.5, "border": true, "letterSpacingEm": 0, "marginTopPx": 10, "paddingBottomPx": 14 }
    }
  },

  "latinText": {
    "$comment": "English body text (.r-text.en p): replaces the paper's font, line height, letter spacing, alignment and size.",
    "font": "latinSerif", "lineHeight": 2.25, "letterSpacingEm": 0, "justify": false, "sizePx": 13.5
  },

  "ink": {
    "$comment": "墨线: the line under the sentence being read. Width px, gap below the text px; colour = paper accent.",
    "widthPx": 1.5,
    "gapPx": 2,
    "fallbackSecondsPerChar": 0.12,
    "fallbackMinSeconds": 1.8
  },

  "readerDefaults": {
    "$comment": "Starting values native passes to the reader on iPhone (contract §2). margin/top/bottom are chosen by native per device.",
    "fontSizePx": 18, "marginPx": 24, "topPx": 56, "bottomPx": 88, "paper": "plain"
  }
}
