    },
    "kaminight": {
      "name": "纸本 · 夜", "dark": true,
      "bg": "#1B1A17", "ink": "#E3DED0", "ink2": "#8C8779", "line": "#2E2C27", "accent": "#8FA8C8",
      "hl": "#463F2C", "wave": "#8FA8C8", "glass": "rgba(40,38,34,.84)", "main": "#8FA8C8", "onMain": "#1B1A17",
      "paperAccent": "#8FA8C8",
      "text": { "font": "serif", "lineHeight": 2.05, "paragraphSpacingEm": 0.3, "indentEm": 2, "justify": true, "letterSpacingEm": 0.01, "sizePx": 14.5 },
      "title": { "font": "serif", "sizePx": 25, "weight": 700, "lineHeight": 1.4, "letterSpacingEm": 0.05, "rule": true },
      "meta": { "font": "serif", "sizePx": 10.5, "border": false, "letterSpacingEm": 0.06, "marginTopPx": 0, "paddingBottomPx": 4 }
    },
    "sage": {
