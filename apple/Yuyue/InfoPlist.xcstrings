    "NSMicrophoneUsageDescription" : {
      "comment" : "克隆声音",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To clone a voice, Yuyue records a short passage of you reading. The recording is kept on this device and sent to the ElevenLabs account you connect in Settings when you clone."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "克隆声音时，录一小段你念书的声音。录音存在这台设备上，克隆时会传到你在设置里接的 ElevenLabs 账号。"
          }
        }
      }
    }
